<idea-plugin>
  <id>ei.database</id>
  <name>Moa Database</name>
  <vendor>Moa IDE</vendor>
  <description><![CDATA[
    Oracle, MySQL and PostgreSQL connections, SQL console, result tables, direct MyBatis query runs, SQL log conversion, mapper and DTO generation, ERD.
  ]]></description>

  <resource-bundle>messages.EiDbBundle</resource-bundle>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.java</depends>
  <!-- 정규식 작업대(boot-servers) 옆에 붙는 메뉴. boot-servers 가 먼저 읽혀야 그 자리를 찾는다. -->
  <depends optional="true" config-file="ei-db-bootservers.xml">local.bootservers</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- 지난번에 열려 있던 SQL 콘솔 탭을 다시 연다. -->
    <postStartupActivity implementation="ei.db.console.ConsoleOpener$Restore"/>
    <notificationGroup id="EI Database" displayType="BALLOON" key="notification.group.ei.database"/>
    <!-- 탐색기 -->
    <toolWindow id="EI Database" anchor="right" icon="AllIcons.Nodes.DataTables" factoryClass="ei.db.ui.DbToolWindowFactory"/>
    <!-- .sql 편집기에서 「별칭.칼럼」 칼럼을 한 색으로 -->
    <editorFactoryListener implementation="ei.db.console.ColumnColors"/>
    <!-- 매퍼 XML 표: 편집한 XML 만 다시 읽는다. -->
    <editorFactoryDocumentListener implementation="ei.db.mybatis.MapperIndex$Edits"/>
    <!-- SQL 콘솔 · 결과 -->
    <editorNotificationProvider implementation="ei.db.console.ConsoleBar$Provider"/>
    <actionPromoter implementation="ei.db.console.ConsoleRun$Promoter"/>
    <completion.contributor language="any" implementationClass="ei.db.console.SqlCompletion"/>
    <typedHandler implementation="ei.db.console.DotAutoPopup"/>
    <toolWindow id="EI Database Result" anchor="bottom" icon="AllIcons.Nodes.DataTables" doNotActivateOnStart="true" canCloseContents="true"
                factoryClass="ei.db.console.ResultView$Factory"/>
    <!-- MyBatis: 매퍼 XML 의 문장 옆 실행 아이콘 -->
    <codeInsight.lineMarkerProvider language="XML" implementationClass="ei.db.mybatis.MyBatisLineMarker"/>
    <!-- MyBatis: 매퍼 XML 파일 아이콘 -->
    <iconProvider implementation="ei.db.mybatis.MapperFileIcon"/>
    <!-- MyBatis: 매퍼 인터페이스 ↔ XML 이동, #{} 필드 검사 -->
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="ei.db.mybatis.MapperNav$JavaMarker"/>
    <codeInsight.lineMarkerProvider language="XML" implementationClass="ei.db.mybatis.MapperNav$XmlMarker"/>
    <gotoDeclarationHandler implementation="ei.db.mybatis.MapperNav$GotoXml"/>
    <!-- MyBatis: include refid → sql, resultMap · extends → resultMap -->
    <gotoDeclarationHandler implementation="ei.db.mybatis.MapperRefNav"/>
    <!-- MyBatis: 매퍼 XML 의 parameterType · resultType 등 → 클래스, namespace → 인터페이스, 문장 id → 메서드 -->
    <gotoDeclarationHandler implementation="ei.db.mybatis.MapperXmlNav"/>
    <externalAnnotator language="XML" implementationClass="ei.db.mybatis.ParamFieldAnnotator"/>
    <!-- MyBatis: 매퍼 XML 의 #{} 매개변수 · select AS 별칭 자동 완성, #{} 에서 필드 · 매개변수로 이동 -->
    <completion.contributor language="XML" order="first" implementationClass="ei.db.mybatis.MapperCompletion"/>
    <typedHandler implementation="ei.db.mybatis.MapperAutoPopup"/>
    <gotoDeclarationHandler implementation="ei.db.mybatis.ParamNav"/>
    <!-- MyBatis: 컨트롤러 · 서비스 메서드 → 서비스 → 매퍼 → XML 계층 이동, 매퍼 인터페이스 ↔ XML 빠진 짝 -->
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="ei.db.mybatis.LayerNav"/>
    <!-- 코드 흐름: URL → 컨트롤러 → 서비스 → 매퍼 → XML → 표, 바꾸면 영향, 표에서 찾기, 안 쓰는 것. 창을 열어도 찾지 않는다 -->
    <toolWindow id="ei.db.CodeFlow" anchor="bottom" icon="AllIcons.Hierarchy.Subtypes" doNotActivateOnStart="true"
                factoryClass="ei.db.mybatis.CodeFlowView$Factory"/>
    <localInspection language="XML" shortName="EiMapperXmlMissingMethod" bundle="messages.EiDbBundle" key="inspection.EiMapperXmlMissingMethod.display.name"
                     groupName="MyBatis" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="ei.db.mybatis.MapperPairInspection$Xml"/>
    <localInspection language="JAVA" shortName="EiMapperMissingStatement" bundle="messages.EiDbBundle" key="inspection.EiMapperMissingStatement.display.name"
                     groupName="MyBatis" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="ei.db.mybatis.MapperPairInspection$Java"/>
    <!-- MyBatis: 매퍼 XML 의 SQL 에서 DB 에 없는 칼럼(경고) · 표(약한 경고). 읽어 둔 표 · 칼럼 목록만 본다 -->
    <localInspection language="XML" shortName="EiMapperSqlUnknownName" bundle="messages.EiDbBundle" key="inspection.EiMapperSqlUnknownName.display.name"
                     groupName="MyBatis" enabledByDefault="true" level="WARNING"
                     implementationClass="ei.db.mybatis.MapperSqlInspection"/>
    <!-- MyBatis: 매퍼 필드를 가진 클래스에서 서비스 메서드 자동 완성 -->
    <completion.contributor language="JAVA" implementationClass="ei.db.mybatis.ServiceMethodCompletion"/>
    <!-- 주석 만들기: 설정 → 도구 → 주석 만들기(작성자 · 날짜 · 사전) -->
    <applicationConfigurable parentId="tools" instance="ei.db.mybatis.DocCommentSettings$Page" id="ei.db.doccomment"
                             key="doccomment.settings.title" bundle="messages.EiDbBundle"/>
    <!-- 고치기 전 백업: 설정 → 도구 → 고치기 전 백업(켬 · 행 한도 · 보존 일수) -->
    <applicationConfigurable parentId="tools" instance="ei.db.console.Backups$Page" id="ei.db.backup"
                             key="backup.settings.title" bundle="messages.EiDbBundle"/>
    <!-- ERD 도구 창은 ErdView 가 처음 열 때 등록한다. -->
  </extensions>

  <applicationListeners>
    <!-- 프로젝트를 닫을 때 열린 SQL 콘솔 탭을 기억한다. -->
    <listener class="ei.db.console.ConsoleOpener$Remember" topic="com.intellij.openapi.project.ProjectCloseListener"/>
    <!-- 매퍼 XML 표: 디스크에서 바뀐 XML 만 다시 읽고, XML · 폴더 구조가 바뀌면 다시 만든다. -->
    <listener class="ei.db.mybatis.MapperIndex$Files" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
  </applicationListeners>

  <projectListeners>
    <!-- 매퍼 XML 표: 소스 · 콘텐츠 루트가 바뀌면 다시 만든다. -->
    <listener class="ei.db.mybatis.MapperIndex$Roots" topic="com.intellij.openapi.roots.ModuleRootListener"/>
  </projectListeners>

  <actions>
    <action id="ei.db.console.Run" class="ei.db.console.ConsoleRun$Statement" icon="AllIcons.Actions.Execute">
      <keyboard-shortcut keymap="$default" first-keystroke="control ENTER"/>
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
    </action>
    <action id="ei.db.console.RunAll" class="ei.db.console.ConsoleRun$All" icon="AllIcons.Actions.RunAll">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift ENTER"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.Run"/>
    </action>
    <action id="ei.db.console.Format" class="ei.db.console.ConsoleRun$Format" icon="AllIcons.Actions.ReformatCode">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift F"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.RunAll"/>
    </action>
    <action id="ei.db.console.Upper" class="ei.db.console.ConsoleRun$Upper" icon="/icons/ei/textUpper.svg">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift X"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.Format"/>
    </action>
    <action id="ei.db.console.Lower" class="ei.db.console.ConsoleRun$Lower" icon="/icons/ei/textLower.svg">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift Y"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.Upper"/>
    </action>
    <action id="ei.db.console.Explain" class="ei.db.console.ConsoleRun$Explain" icon="AllIcons.Actions.Preview">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift E"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.RunAll"/>
    </action>
    <!-- 콘솔 우클릭은 서버 창 플러그인의 「작업대」 묶음에 들어간다(ei-db-bootservers.xml). -->
    <action id="ei.db.console.QueryBench" class="ei.db.console.QueryBenchAction$InConsole" icon="AllIcons.Actions.Edit"/>
    <action id="ei.db.QueryBench" class="ei.db.console.QueryBenchAction">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="ei.db.BackupView" class="ei.db.console.BackupViewAction">
      <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="ei.db.QueryBench"/>
    </action>
    <action id="EiDb.MyBatis.Run" class="ei.db.mybatis.RunStatementAction" icon="AllIcons.Actions.Execute">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt ENTER"/>
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
    </action>
    <action id="EiDb.MyBatis.FindSlow" class="ei.db.mybatis.RunStatementAction$FindSlow" icon="AllIcons.Actions.Preview">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.Run"/>
    </action>
    <action id="EiDb.MyBatis.LayerCode" class="ei.db.mybatis.LayerCodeAction" icon="AllIcons.Actions.Lightning">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.FindSlow"/>
    </action>
    <action id="EiDb.MyBatis.ServiceCall" class="ei.db.mybatis.ServiceCallAction" icon="AllIcons.Actions.Copy">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.LayerCode"/>
    </action>
    <action id="EiDb.MyBatis.ColumnRename" class="ei.db.mybatis.ColumnRenameAction" icon="/icons/ei/columnRename.svg">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.ServiceCall"/>
      <add-to-group group-id="KG.SourceMenu" anchor="last"/>
    </action>
    <action id="EiDb.MyBatis.DynamicWhere" class="ei.db.mybatis.DynamicWhereAction" icon="/icons/ei/dynamicWhere.svg">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.ColumnRename"/>
    </action>
    <action id="EiDb.MyBatis.Paging" class="ei.db.mybatis.PagingAction" icon="/icons/ei/paging.svg">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.DynamicWhere"/>
    </action>
    <action id="EiDb.MyBatis.ResultMap" class="ei.db.mybatis.ResultMapAction" icon="AllIcons.Nodes.Field">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.Paging"/>
    </action>
    <group id="EiDb.MyBatis.Tags" class="ei.db.mybatis.TagGroup" popup="true" icon="AllIcons.FileTypes.Xml">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.Paging"/>
    </group>
    <action id="EiDb.MyBatis.StringSql" class="ei.db.mybatis.StringSqlAction" icon="AllIcons.Actions.ReformatCode">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.Paging"/>
    </action>
    <group id="EiDb.MyBatis.LogGroup">
      <action id="EiDb.MyBatis.LogRun" class="ei.db.mybatis.LogActions$Run" icon="/icons/ei/logRun.svg"/>
      <action id="EiDb.MyBatis.LogSend" class="ei.db.mybatis.LogActions$Send" icon="/icons/ei/logSend.svg"/>
      <separator/>
      <add-to-group group-id="ConsoleView.PopupMenu" anchor="first"/>
    </group>
    <action id="ei.db.console.ResultCompare" class="ei.db.console.ResultCompare$OpenAction" icon="AllIcons.Actions.Diff">
      <add-to-group group-id="ToolWindowContextMenu" anchor="last"/>
    </action>
    <action id="ei.db.gen.Feature" class="ei.db.gen.FeatureAction" icon="/icons/ei/genFeature.svg">
      <add-to-group group-id="KG.SourceMenu" anchor="last"/>
    </action>
    <action id="ei.db.gen.JsonDto" class="ei.db.gen.JsonDtoAction" icon="/icons/ei/jsonDto.svg">
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
      <add-to-group group-id="KG.SourceMenu" anchor="last"/>
    </action>
    <action id="ei.db.gen.Validation" class="ei.db.gen.ValidationAction" icon="/icons/ei/validation.svg">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <add-to-group group-id="KG.SourceMenu" anchor="last"/>
    </action>
    <!-- 편집기 우클릭 「주석 만들기」: 자바 메서드 · 클래스 문서 주석, 매퍼 XML 은 SQL 아이디 주석.
         메뉴 자리(정규식 작업대 아래)는 boot-servers 가 있을 때 ei-db-bootservers.xml 이 붙인다. -->
    <action id="ei.db.DocComment" class="ei.db.mybatis.DocCommentAction" icon="AllIcons.Actions.InlayRenameInComments"/>
    <action id="ei.db.gen.EnumSync" class="ei.db.gen.EnumSyncAction" icon="/icons/ei/enumSync.svg">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <!-- 자바 편집기 우클릭: 호출 흐름 보기 · 바꾸면 영향 보기(결과는 코드 흐름 창) -->
    <action id="ei.db.CodeFlow.Flow" class="ei.db.mybatis.CodeFlowAction$Flow" icon="AllIcons.Hierarchy.Subtypes">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EiDb.MyBatis.LayerCode"/>
    </action>
    <action id="ei.db.CodeFlow.Impact" class="ei.db.mybatis.CodeFlowAction$Impact" icon="AllIcons.Hierarchy.Supertypes">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.CodeFlow.Flow"/>
    </action>
  </actions>
</idea-plugin>
