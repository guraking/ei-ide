<idea-plugin>
  <id>ei.database</id>
  <name>EI Database</name>
  <vendor>EI IDE</vendor>
  <description><![CDATA[
    Oracle · MySQL · PostgreSQL 접속, SQL 콘솔, 결과 표, MyBatis 쿼리 바로 실행, SQL 로그 변환, 매퍼 · DTO 생성, ERD.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.java</depends>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="EI Database" displayType="BALLOON"/>
    <!-- 탐색기 -->
    <toolWindow id="EI Database" anchor="right" icon="AllIcons.Nodes.DataTables" factoryClass="ei.db.ui.DbToolWindowFactory"/>
    <!-- SQL 콘솔 · 결과 -->
    <editorNotificationProvider implementation="ei.db.console.ConsoleBar$Provider"/>
    <actionPromoter implementation="ei.db.console.ConsoleRun$Promoter"/>
    <completion.contributor language="any" implementationClass="ei.db.console.SqlCompletion"/>
    <typedHandler implementation="ei.db.console.DotAutoPopup"/>
    <toolWindow id="EI Database Result" anchor="bottom" icon="AllIcons.Nodes.DataTables" doNotActivateOnStart="true" canCloseContents="true"
                factoryClass="ei.db.console.ResultView$Factory"/>
    <!-- MyBatis: 매퍼 XML 의 문장 옆 실행 아이콘 -->
    <codeInsight.lineMarkerProvider language="XML" implementationClass="ei.db.mybatis.MyBatisLineMarker"/>
    <!-- MyBatis: 매퍼 인터페이스 ↔ XML 이동, #{} 필드 검사 -->
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="ei.db.mybatis.MapperNav$JavaMarker"/>
    <codeInsight.lineMarkerProvider language="XML" implementationClass="ei.db.mybatis.MapperNav$XmlMarker"/>
    <gotoDeclarationHandler implementation="ei.db.mybatis.MapperNav$GotoXml"/>
    <!-- MyBatis: include refid → sql, resultMap · extends → resultMap -->
    <gotoDeclarationHandler implementation="ei.db.mybatis.MapperRefNav"/>
    <externalAnnotator language="XML" implementationClass="ei.db.mybatis.ParamFieldAnnotator"/>
    <!-- ERD 도구 창은 ErdView 가 처음 열 때 등록한다. -->
  </extensions>

  <actions>
    <action id="ei.db.console.Run" class="ei.db.console.ConsoleRun$Statement" text="실행"
            description="선택 영역 또는 커서가 있는 문장을 실행합니다" icon="AllIcons.Actions.Execute">
      <keyboard-shortcut keymap="$default" first-keystroke="control ENTER"/>
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
    </action>
    <action id="ei.db.console.RunAll" class="ei.db.console.ConsoleRun$All" text="전체 실행"
            description="콘솔의 모든 문장을 차례로 실행합니다" icon="AllIcons.Actions.RunAll">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift ENTER"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.Run"/>
    </action>
    <action id="ei.db.console.Format" class="ei.db.console.ConsoleRun$Format" text="SQL 정렬"
            description="선택 영역(없으면 콘솔 전체)의 SQL 을 줄 맞춰 정렬합니다" icon="AllIcons.Actions.ReformatCode">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift F"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.RunAll"/>
    </action>
    <action id="ei.db.console.Upper" class="ei.db.console.ConsoleRun$Upper" text="대문자로"
            description="선택 영역(없으면 콘솔 전체)을 대문자로 바꿉니다. 문자열 · 주석은 그대로 둡니다">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift X"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.Format"/>
    </action>
    <action id="ei.db.console.Lower" class="ei.db.console.ConsoleRun$Lower" text="소문자로"
            description="선택 영역(없으면 콘솔 전체)을 소문자로 바꿉니다. 문자열 · 주석은 그대로 둡니다">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift Y"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.Upper"/>
    </action>
    <action id="ei.db.console.Explain" class="ei.db.console.ConsoleRun$Explain" text="실행 계획"
            description="선택 영역 또는 커서가 있는 문장의 실행 계획을 봅니다. 문장은 실행하지 않습니다" icon="AllIcons.Actions.Preview">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift E"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ei.db.console.RunAll"/>
    </action>
    <action id="EiDb.MyBatis.Run" class="ei.db.mybatis.RunStatementAction" text="MyBatis 쿼리 실행" icon="AllIcons.Actions.Execute">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt ENTER"/>
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
    </action>
    <group id="EiDb.MyBatis.LogGroup">
      <action id="EiDb.MyBatis.LogCopy" class="ei.db.mybatis.LogActions$Copy" text="SQL 로 바꿔 복사">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt C"/>
      </action>
      <action id="EiDb.MyBatis.LogRun" class="ei.db.mybatis.LogActions$Run" text="데이터베이스 콘솔에서 실행"/>
      <action id="EiDb.MyBatis.LogSend" class="ei.db.mybatis.LogActions$Send" text="쿼리 콘솔로 보내기"/>
      <action id="EiDb.MyBatis.LogOpen" class="ei.db.mybatis.LogActions$Open" text="MyBatis 실행 창으로 열기"/>
      <separator/>
      <add-to-group group-id="ConsoleView.PopupMenu" anchor="first"/>
    </group>
    <action id="ei.db.console.ResultCompare" class="ei.db.console.ResultCompare$OpenAction" text="다른 결과와 비교…"
            description="이 결과와 다른 결과 탭을 기준 칼럼으로 맞춰 비교합니다" icon="AllIcons.Actions.Diff">
      <add-to-group group-id="ToolWindowContextMenu" anchor="last"/>
    </action>
    <action id="ei.db.gen.Feature" class="ei.db.gen.FeatureAction" text="기능 한 벌 만들기…"
            description="데이터베이스 탐색기에서 고른 표로 DTO · 매퍼 XML · 매퍼 인터페이스 · 서비스 · 컨트롤러를 한 번에 만듭니다">
      <add-to-group group-id="KG.SourceMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
