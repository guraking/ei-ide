<idea-plugin>
    <id>local.bootservers</id>
    <name>서버 창</name>
    <vendor>개인</vendor>
    <description><![CDATA[
        Right-click a module in the project tree to start, debug, restart or stop its Spring Boot server,
        and see the state next to running modules.
        The bottom Servers window handles several servers at once and edits profiles, VM options and ports.
    ]]></description>
    <resource-bundle>messages.BootServersBundle</resource-bundle>

    <depends>com.intellij.java</depends>
    <depends>Git4Idea</depends>
    <depends>com.intellij.modules.json</depends>
    <!-- 262 부터 내장 브라우저(JCEF)는 따로 된 플러그인이다. Swagger 화면이 쓴다. -->
    <depends>com.intellij.modules.jcef</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectViewNodeDecorator implementation="local.bootservers.ServerStatusDecorator"/>
        <!-- 바뀐 파일 · 새 파일이 아래에 있는 폴더 · 패키지 아이콘을 그 색으로 칠한다 -->
        <projectViewNodeDecorator implementation="local.bootservers.ChangedFolderIconDecorator"/>
        <!-- 이름으로 고른 폴더 · 패키지 아이콘, 커뮤니티판에 아이콘이 없는 파일 종류 아이콘(/icons/ei/*.properties) -->
        <iconProvider implementation="local.bootservers.icons.FolderIcons" order="first"/>
        <fileIconProvider implementation="local.bootservers.icons.FileIcons" order="first"/>
        <toolWindow id="Servers" anchor="bottom" icon="AllIcons.Nodes.Services"
                    factoryClass="local.bootservers.ServersToolWindowFactory"/>
        <defaultToolWindowLayout implementation="local.bootservers.ToolWindowOrder" order="last"/>
        <notificationGroup id="EI IDE 새 판" key="notification.group.update" displayType="STICKY_BALLOON"/>
        <notificationGroup id="서버 실행" key="notification.group.servers" displayType="BALLOON"/>
        <notificationGroup id="프로그램 목록" key="notification.group.programs" displayType="BALLOON"/>
        <!-- @Controller 뷰 이름 글 Ctrl+클릭 → JSP, 주석 속성 ${키} Ctrl+클릭 → application*.yml · properties 의 키 줄 -->
        <gotoDeclarationHandler implementation="local.bootservers.ViewNameGotoHandler"/>
        <gotoDeclarationHandler implementation="local.bootservers.ConfigKeyGotoHandler"/>
        <!-- OpenAPI: 아래쪽 「API」 창(컨트롤러로 만든 사양의 Swagger UI), 사양 파일 옆 미리보기, 사양 파일 자동 완성 · 오류 표시 -->
        <toolWindow id="API" anchor="bottom" icon="AllIcons.Nodes.PpWeb" doNotActivateOnStart="true"
                    factoryClass="local.bootservers.SwaggerToolWindow"/>
        <!-- 오른쪽 옆줄 「보안 메모」: 내가 정한 비밀번호로만 열리는 암호화 메모장 -->
        <toolWindow id="Secure Memo" anchor="right" icon="AllIcons.Ide.Readonly" doNotActivateOnStart="true"
                    factoryClass="local.bootservers.memo.SecureMemoToolWindowFactory"/>
        <fileEditorProvider implementation="local.bootservers.OpenApiEditorProvider"/>
        <!-- JDK 24 이상 실행에 sun-misc-unsafe-memory-access=allow 옵션을 더해 Unsafe 경고를 끈다 -->
        <java.programPatcher implementation="local.bootservers.UnsafeWarningPatcher"/>
        <!-- EI Glass: Islands Dark 위에 숯색 판 · 분홍 강조색을 얹은 테마와 그 에디터 색. 첫 실행 기본 테마는 apply_defaults 22번 -->
        <themeProvider id="EI Glass" path="/themes/EIGlass.theme.json" targetUi="islands"/>
        <bundledColorScheme id="EI Glass" path="/themes/EIGlass.xml"/>
        <!-- EI Glass 와 같은 키 구조의 테마 넷. Frost · Sand · Paper 는 Islands Light(에디터 색 부모 Default), Dusk 는 Islands Dark(부모 Darcula) 위에 얹는다 -->
        <themeProvider id="EI Frost" path="/themes/EIFrost.theme.json" targetUi="islands"/>
        <bundledColorScheme id="EI Frost" path="/themes/EIFrost.xml"/>
        <themeProvider id="EI Sand" path="/themes/EISand.theme.json" targetUi="islands"/>
        <bundledColorScheme id="EI Sand" path="/themes/EISand.xml"/>
        <themeProvider id="EI Paper" path="/themes/EIPaper.theme.json" targetUi="islands"/>
        <bundledColorScheme id="EI Paper" path="/themes/EIPaper.xml"/>
        <themeProvider id="EI Dusk" path="/themes/EIDusk.theme.json" targetUi="islands"/>
        <bundledColorScheme id="EI Dusk" path="/themes/EIDusk.xml"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="local.bootservers.OpenApiSchemas"/>
    </extensions>

    <!-- JavaScript · TypeScript · Vue: vtsls · Vue 언어 서버(LSP). Node · 서버는 사용자 폴더의 .ei-web 아래 -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="웹 언어 지원" key="notification.group.web" displayType="BALLOON"/>
        <notificationGroup id="AI" key="notification.group.ai" displayType="BALLOON"/>
        <!-- 코드 도구(local.bootservers.code) -->
        <notificationGroup id="요청 값 묶기" key="notification.group.params" displayType="BALLOON"/>
        <localInspection language="JAVA" shortName="EiLogUsage" key="inspection.log.usage.display.name"
                         groupKey="inspection.group.ei.code" bundle="messages.BootServersBundle" enabledByDefault="true" level="WARNING"
                         implementationClass="local.bootservers.code.LogUsageInspection"/>
        <platform.lsp.serverSupportProvider implementation="local.bootservers.web.WebLspSupport"/>
        <platform.lsp.serverSupportProvider implementation="local.bootservers.web.VueLspSupport"/>
    </extensions>

    <applicationListeners>
        <listener class="local.bootservers.UpdateCheck" topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="local.bootservers.BundledFonts" topic="com.intellij.ide.AppLifecycleListener"/>
        <!-- 사용자 폴더 .jdks 의 JDK(플러그인설치.bat 이 푼 것)를 SDK 목록에 등록 -->
        <listener class="local.bootservers.JdkAutoRegister" topic="com.intellij.ide.AppLifecycleListener"/>
        <!-- 아이콘 없는 기본 메뉴 · 우클릭 동작에 아이콘(/icons/ei/menu-icons.properties) -->
        <listener class="local.bootservers.icons.MenuIcons" topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="local.bootservers.ServerStatusRefresher" topic="com.intellij.execution.ExecutionListener"/>
        <!-- 아래쪽 창을 닫으면 그 창이 가렸던 직전 창을 다시 연다 -->
        <listener class="local.bootservers.ReopenPreviousToolWindow" topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
        <!-- 새 파일(버전 관리 밖) 위 폴더 목록을 변경 목록 갱신 때마다 만든다(ChangedFolderIconDecorator 가 씀) -->
        <listener class="local.bootservers.UnversionedDirs" topic="com.intellij.openapi.vcs.changes.ChangeListListener"/>
    </projectListeners>

    <actions>
        <group id="BootServers.Menu" class="local.bootservers.ServerActions$Menu" popup="true"
               icon="AllIcons.Nodes.Services">
            <action id="BootServers.Start" class="local.bootservers.ServerActions$Start" icon="AllIcons.Actions.Execute"/>
            <action id="BootServers.Debug" class="local.bootservers.ServerActions$Debug" icon="AllIcons.Actions.StartDebugger"/>
            <action id="BootServers.Restart" class="local.bootservers.ServerActions$Restart" icon="AllIcons.Actions.Restart"/>
            <action id="BootServers.Stop" class="local.bootservers.ServerActions$Stop" icon="AllIcons.Actions.Suspend"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </group>

        <!-- 이클립스 Import · Team 메뉴 대응. 인텔리제이 기본 동작을 우클릭 메뉴에 연결만 한다. -->
        <group id="BootServers.Workspace" popup="true" icon="AllIcons.Nodes.Folder">
            <reference ref="ImportModule"/>
            <reference ref="Vcs.VcsClone"/>
            <separator/>
            <reference ref="Git.Init"/>
            <reference ref="Git.Configure.Remotes"/>
            <add-to-group group-id="ProjectViewPopupMenu" relative-to-action="BootServers.Menu" anchor="after"/>
        </group>

        <!-- 이클립스 키맵은 Ctrl+F 를 「바꾸기」 에 주므로, 콘솔에서만 켜지는 찾기를 Ctrl+F 에 따로 건다. 이클립스 키맵은 $default 를 물려받는다. -->
        <action id="KingGura.ConsoleFind" class="local.bootservers.ConsoleFindAction" icon="AllIcons.Actions.Find">
            <keyboard-shortcut keymap="$default" first-keystroke="control F"/>
        </action>
        <!-- 이클립스처럼 프로젝트 창에서 F5 로 디스크에서 다시 읽기. 이클립스 키맵의 F5(Step Into)는 프로젝트 창 밖에서 그대로다. -->
        <action id="KingGura.ProjectViewRefresh" class="local.bootservers.ProjectViewRefreshAction" icon="AllIcons.Actions.Refresh">
            <keyboard-shortcut keymap="Eclipse" first-keystroke="F5"/>
        </action>
        <!-- 콘솔 우클릭 메뉴: 지금 콘솔 글을 레벨 · 검색어로 거르는 창을 연다. -->
        <action id="KingGura.LogFilter" class="local.bootservers.LogFilterAction" icon="AllIcons.General.Filter">
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="first"/>
        </action>
        <!-- Navigate · Search 메뉴: 스프링 요청 매핑 목록에서 URL 로 컨트롤러 메서드를 찾는다. 이클립스 키맵은 $default 를 물려받는다. -->
        <action id="KingGura.FindUrlMapping" class="local.bootservers.UrlMappingAction" icon="AllIcons.Nodes.PpWeb">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift U"/>
            <add-to-group group-id="GoToMenu" anchor="first"/>
            <add-to-group group-id="KG.SearchMenu" anchor="last"/>
        </action>
        <!-- Run 메뉴: 아래쪽 「API」 창을 열어 컨트롤러 API 를 Swagger UI 로 시험한다. -->
        <action id="KingGura.ApiTest" class="local.bootservers.SwaggerToolWindow$OpenAction" icon="AllIcons.Nodes.PpWeb">
            <add-to-group group-id="RunMenu" anchor="last"/>
        </action>
        <!-- Project 메뉴 · 프로젝트 창 우클릭: 소스 · 리소스 · 웹 폴더의 전체 파일과 URL 매핑을 엑셀 한 파일로 저장한다(프로그램 사양서용). -->
        <action id="KingGura.ExportProgramList" class="local.bootservers.ProgramListAction" icon="AllIcons.ToolbarDecorator.Export">
            <add-to-group group-id="KG.ProjectMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" relative-to-action="BootServers.Workspace" anchor="after"/>
        </action>
        <!-- JSP 편집기 우클릭: 이 JSP 를 뷰로 돌려주는 컨트롤러 글로 이동 -->
        <action id="KingGura.GoToController" class="local.bootservers.GoToControllerAction" icon="AllIcons.Nodes.Class">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <!-- 편집기 우클릭 「표기법 바꾸기」: 고른 글 안의 식별자를 카멜 · 파스칼 · 스네이크 · 대문자 스네이크로 바꾼다. 문자열 · 주석은 둔다. -->
        <group id="KingGura.CaseConvert" popup="true" icon="/icons/ei/caseConvert.svg">
            <action id="KingGura.CaseCamel" class="local.bootservers.CaseConvertActions$Camel" icon="/icons/ei/caseCamel.svg"/>
            <action id="KingGura.CasePascal" class="local.bootservers.CaseConvertActions$Pascal" icon="/icons/ei/casePascal.svg"/>
            <action id="KingGura.CaseSnake" class="local.bootservers.CaseConvertActions$Snake" icon="/icons/ei/caseSnake.svg"/>
            <action id="KingGura.CaseUpperSnake" class="local.bootservers.CaseConvertActions$UpperSnake" icon="/icons/ei/caseUpperSnake.svg"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
        <!-- 편집기 · 콘솔 우클릭 「AI」: 고른 코드 · 로그를 프롬프트 파일로 만들어 터미널 새 탭에서 Claude Code 를 시작한다 -->
        <group id="KingGura.AiEditor" popup="true" icon="AllIcons.Toolwindows.ToolWindowAskAI">
            <action id="KingGura.AiExplain" class="local.bootservers.ai.AiActions$Explain" icon="/icons/ei/aiExplain.svg"/>
            <action id="KingGura.AiFix" class="local.bootservers.ai.AiActions$Fix" icon="/icons/ei/aiFix.svg"/>
            <action id="KingGura.AiAsk" class="local.bootservers.ai.AiActions$Ask" icon="/icons/ei/aiAsk.svg"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
        <group id="KingGura.AiConsole" popup="true" icon="AllIcons.Toolwindows.ToolWindowAskAI">
            <action id="KingGura.AiConsoleError" class="local.bootservers.ai.AiActions$ConsoleError" icon="/icons/ei/aiConsoleError.svg"/>
            <add-to-group group-id="ConsoleView.PopupMenu" anchor="last"/>
        </group>
        <!-- 코드 도구: 요청 값 묶기 -->
        <action id="KingGura.BundleRequestParams" class="local.bootservers.code.ParamBundleAction" icon="AllIcons.Nodes.Class">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="KG.SourceMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
