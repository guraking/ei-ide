<idea-plugin>
  <id>kinggura.sync</id>
  <name>EI Synchronize</name>
  <vendor>EI IDE</vendor>
  <description><![CDATA[
    Shows incoming changes, outgoing changes and conflicts against the remote in one window, like Eclipse Team › Synchronize Workspace.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.vcs</depends>
  <!-- Git 은 저장소 변경 알림(GIT_REPO_CHANGE)을 받으려 플러그인이 필요하다. SVN 은 svn 명령줄만 쓰므로 svn4idea 없이도 된다. -->
  <depends>Git4Idea</depends>
  <!-- SVN 플러그인이 있으면 트리 우클릭 Subversion 묶음에도 「작업 공간 동기화」를 넣는다. -->
  <depends optional="true" config-file="kinggura-sync-svn.xml">Subversion</depends>

  <!-- 화면 글 묶음: 기본 영어, _ko 한국어. -->
  <resource-bundle>messages.SyncBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Synchronize" anchor="bottom" icon="AllIcons.Actions.Refresh"
                factoryClass="kinggura.sync.SyncToolWindowFactory"/>
    <!-- 「Git Log」: 프로젝트(모듈)를 골라 그 폴더의 커밋만 GitKraken 처럼 본다. 기존 Git 로그 창은 그대로 둔다. -->
    <toolWindow id="ProjectHistory" anchor="bottom" icon="AllIcons.Vcs.History"
                factoryClass="kinggura.sync.ProjectHistoryPanel$Factory"/>
    <!-- Clone 창 Directory 기본값을 프로젝트 안이 아니라 프로젝트 옆(상위 폴더)으로. -->
    <clonePathProvider implementation="kinggura.sync.CloneNextToProject"/>
    <!-- Clone 이 끝나면 새 창으로 열지 않고 지금 프로젝트에 모듈로 붙인다. IntelliJ 의 열기 리스너(ProjectDirCheckoutListener 가 first)보다 먼저 돈다. -->
    <checkoutListener implementation="kinggura.sync.CloneIntoProject" order="first, before ProjectDirCheckoutListener"/>
    <!-- 워크스페이스 폴더 프로젝트를 열 때 그 폴더 자체 모듈(「git」 줄)을 뺀다. -->
    <postStartupActivity implementation="kinggura.sync.CloneIntoProject"/>
  </extensions>

  <projectListeners>
    <!-- 저장소 목록이 잡힐 때마다 .git/info/exclude 에 IDE · 이클립스 파일 줄을 넣는다.
         topic 은 VCS_CONFIGURATION_CHANGED 가 쓰는 VcsMappingListener 여야 한다(VcsListener 이름으로는 알림이 오지 않는다). -->
    <listener class="kinggura.sync.ExcludeIdeFiles" topic="com.intellij.openapi.vcs.VcsMappingListener"/>
  </projectListeners>

  <actions>
    <!-- 커밋 창 · 변경 목록 우클릭에도 동기화 창과 같은 「Assume Unchanged」 를 둔다. -->
    <action id="KingGura.AssumeUnchanged" class="kinggura.sync.AssumeUnchangedAction" icon="/icons/ei/assumeUnchanged.svg">
      <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
      <!-- 스테이징을 켜면 커밋 창이 Staged · Unstaged 목록으로 바뀌고 우클릭 메뉴도 이 묶음을 쓴다. -->
      <add-to-group group-id="Git.Stage.Tree.Menu" anchor="last"/>
    </action>
    <!-- 프로젝트 트리에서 고른 파일에도 모른 척하기 · 풀기. 모른 척 중인 파일은 변경 목록에 안 뜨므로 풀기는 여기와 동기화 창에 둔다. -->
    <group id="KingGura.AssumeGroup">
      <separator/>
      <reference ref="KingGura.AssumeUnchanged"/>
      <action id="KingGura.AssumeUnchanged.Undo" class="kinggura.sync.AssumeUnchangedAction$Undo" icon="/icons/ei/assumeUnchangedUndo.svg"/>
      <separator/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
    </group>
    <action id="KingGura.SynchronizeWorkspace" class="kinggura.sync.SyncToolWindowFactory$OpenAction" icon="AllIcons.Actions.Refresh">
      <add-to-group group-id="Git.MainMenu" anchor="first"/>
      <add-to-group group-id="Git.ContextMenu" anchor="first"/>
    </action>
    <!-- 서버의 기준 브랜치(develop 등)를 개인 브랜치에 합치는 역머지. 합치기 전에 들어올 파일 · 내 파일과 겹치는 파일을 보여 준다. -->
    <action id="KingGura.ReverseMerge" class="kinggura.sync.ReverseMergeAction" icon="AllIcons.Vcs.Merge">
      <add-to-group group-id="Git.MainMenu" anchor="after" relative-to-action="KingGura.SynchronizeWorkspace"/>
      <add-to-group group-id="Git.ContextMenu" anchor="after" relative-to-action="KingGura.SynchronizeWorkspace"/>
    </action>
  </actions>
</idea-plugin>
