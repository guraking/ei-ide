<idea-plugin>
  <id>kinggura.sync</id>
  <name>EI Synchronize</name>
  <vendor>EI IDE</vendor>
  <description><![CDATA[
    이클립스 Team › Synchronize Workspace 처럼 원격과 비교해 들어올 변경 · 나갈 변경 · 충돌을 한 창에서 보여 준다.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.vcs</depends>
  <!-- Git 은 저장소 변경 알림(GIT_REPO_CHANGE)을 받으려 플러그인이 필요하다. SVN 은 svn 명령줄만 쓰므로 svn4idea 없이도 된다. -->
  <depends>Git4Idea</depends>
  <!-- SVN 플러그인이 있으면 트리 우클릭 Subversion 묶음에도 「작업 공간 동기화」를 넣는다. -->
  <depends optional="true" config-file="kinggura-sync-svn.xml">Subversion</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Synchronize" anchor="bottom" icon="AllIcons.Actions.Refresh"
                factoryClass="kinggura.sync.SyncToolWindowFactory"/>
    <!-- 「Git 기록」: 프로젝트(모듈)를 골라 그 폴더의 커밋만 GitKraken 처럼 본다. 기존 Git 로그 창은 그대로 둔다. -->
    <toolWindow id="ProjectHistory" anchor="bottom" icon="AllIcons.Vcs.History"
                factoryClass="kinggura.sync.ProjectHistoryPanel$Factory"/>
  </extensions>

  <projectListeners>
    <!-- 저장소 목록이 잡힐 때마다 .git/info/exclude 에 IDE · 이클립스 파일 줄을 넣는다.
         topic 은 VCS_CONFIGURATION_CHANGED 가 쓰는 VcsMappingListener 여야 한다(VcsListener 이름으로는 알림이 오지 않는다). -->
    <listener class="kinggura.sync.ExcludeIdeFiles" topic="com.intellij.openapi.vcs.VcsMappingListener"/>
  </projectListeners>

  <actions>
    <!-- 커밋 창 · 변경 목록 우클릭에도 동기화 창과 같은 「Assume Unchanged」 를 둔다. -->
    <action id="KingGura.AssumeUnchanged" class="kinggura.sync.AssumeUnchangedAction" text="Assume Unchanged">
      <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
    </action>
    <!-- 프로젝트 트리에서 고른 파일에도 모른 척하기 · 풀기. 모른 척 중인 파일은 변경 목록에 안 뜨므로 풀기는 여기와 동기화 창에 둔다. -->
    <group id="KingGura.AssumeGroup">
      <separator/>
      <reference ref="KingGura.AssumeUnchanged"/>
      <action id="KingGura.AssumeUnchanged.Undo" class="kinggura.sync.AssumeUnchangedAction$Undo" text="No Assume Unchanged"/>
      <separator/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
    </group>
    <action id="KingGura.SynchronizeWorkspace" class="kinggura.sync.SyncToolWindowFactory$OpenAction"
            text="작업 공간 동기화" icon="AllIcons.Actions.Refresh">
      <add-to-group group-id="Git.MainMenu" anchor="first"/>
      <add-to-group group-id="Git.ContextMenu" anchor="first"/>
    </action>
  </actions>
</idea-plugin>
